# Exemplo de configuracao do backend. Copie para .env (ignorado pelo git) e
# ajuste. Nunca versione o .env real nem credenciais.

# dev | producao. Em producao o startup recusa CORS "*", ausencia de segredo,
# cookie sem Secure e e-mail simulado.
PONTOFACIL_AMBIENTE=dev

# Origens do frontend (separe por virgula). Use a URL real em producao.
PONTOFACIL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Segredo dos HMACs de codigo/CSRF. Obrigatorio em producao.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
PONTOFACIL_SEGREDO_SESSAO=

# Sessao e codigo de acesso.
PONTOFACIL_SESSAO_INATIVIDADE_MIN=480
PONTOFACIL_SESSAO_ABSOLUTA_DIAS=7
PONTOFACIL_CODIGO_TTL_MIN=10
PONTOFACIL_CODIGO_MAX_TENTATIVAS=5
PONTOFACIL_CODIGO_REENVIO_SEG=60
PONTOFACIL_LOGIN_MAX_FALHAS_EMAIL=10
PONTOFACIL_LOGIN_MAX_FALHAS_IP=30
PONTOFACIL_LOGIN_JANELA_MIN=15
# Cookies Secure: 1 em producao/HTTPS; 0 apenas em dev local via http.
PONTOFACIL_COOKIE_SECURE=0

# E-mail: smtp (real) ou arquivo (somente dev, grava em data/emails).
PONTOFACIL_EMAIL_MODO=arquivo
PONTOFACIL_SMTP_HOST=
PONTOFACIL_SMTP_PORTA=587
# starttls | ssl
PONTOFACIL_SMTP_SEGURANCA=starttls
PONTOFACIL_SMTP_USUARIO=
PONTOFACIL_SMTP_SENHA=
PONTOFACIL_SMTP_REMETENTE=
PONTOFACIL_SMTP_TIMEOUT=20

# Caminhos persistentes (use volume duravel em producao).
PONTOFACIL_OUTPUT_DIR=backend/_out
PONTOFACIL_DATA_DIR=data
PONTOFACIL_DB_PATH=data/pontofacil.db
PONTOFACIL_LOG_DIR=logs
PONTOFACIL_EMAIL_DIR=data/emails
PONTOFACIL_TIMEZONE=America/Sao_Paulo

# OCR / PaddleOCR.
PADDLEOCR_MCP_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_MCP_PPOCR_SOURCE=aistudio
PADDLEOCR_MCP_AISTUDIO_ACCESS_TOKEN=

# Recursos locais (sincronizacao de Excel). Desligue em servidor publicado.
PONTOFACIL_SYNC_ENABLED=1
PONTOFACIL_MAX_ARQUIVO_MB=20
# Limite total do lote por requisicao (soma de todos os arquivos).
PONTOFACIL_MAX_LOTE_MB=80
# Chamados processados ao mesmo tempo (1 = serial).
PONTOFACIL_MAX_CHAMADOS=2
# Imagens enviadas simultaneamente ao MCP dentro de um chamado (1 = serial).
PONTOFACIL_OCR_CONCORRENCIA=10

# Anonimizacao local (PP-StructureV3). Requer o ambiente .venv-anon
# (backend/requirements-anonimizacao.txt). Em caso de duvida, a imagem e
# bloqueada e nunca segue para o OCR externo.
# Inferencias locais simultaneas (1 recomendado em maquinas com 4 GB de RAM).
PONTOFACIL_ANON_CONCORRENCIA=1
# Tempo maximo por imagem, em segundos (inclui carregar o modelo na 1a vez).
PONTOFACIL_ANON_TIMEOUT=180
# Rasterizacao local de PDF de uma pagina.
PONTOFACIL_ANON_PDF_DPI=200
# Margem de seguranca em pixels ao redor da tabela recortada.
PONTOFACIL_ANON_MARGEM_PX=6
# cpu | gpu (gpu exige PaddlePaddle compilado para CUDA).
PONTOFACIL_ANON_DISPOSITIVO=cpu

# --- Frontend (PontoFacil/.env) ---
# VITE_API_URL=http://localhost:8090
